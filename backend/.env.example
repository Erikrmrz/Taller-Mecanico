# Conexión a PostgreSQL local (ajusta usuario, contraseña y puerto)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taller_mecanico?schema=public"

# Secreto para firmar los JWT (mínimo 16 caracteres; usa uno largo y aleatorio)
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Pon true solo si el API está detrás de un proxy (Render, Railway, Nginx)
TRUST_PROXY=false
BCRYPT_ROUNDS=12

# Datos del primer administrador (lo crea `npm run prisma:seed`)
ADMIN_NOMBRE="Administrador"
ADMIN_EMAIL="admin@taller.local"
ADMIN_PASSWORD="Admin1234"
# true = crea también un recepcionista y un mecánico de prueba
SEED_DEMO_USERS=true
